{
  "info": {
    "name": "IS-803 | Práctica 2.4 | Seguridad en tránsito",
    "description": "Inicia Laravel y ejecuta php artisan demo:preparar-api para obtener el token temporal. Configura token_carrito de forma local. Para generar evidencias, captura la respuesta sin mostrar la pestaña Authorization ni los valores de las variables. Ejecuta las solicitudes en orden para verificar la modificación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_carrito}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token_carrito",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "P1 · Consultar carrito propio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/carrito"
      }
    },
    {
      "name": "P1 · Cambiar cantidad a 4",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Devuelve la cantidad actualizada\", function () {",
              "    pm.expect(pm.response.json().data.cantidad).to.eql(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cantidad\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/carrito/articulos/1"
      }
    },
    {
      "name": "P1 · Confirmar cantidad guardada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"El producto 1 tiene cantidad 4\", function () {",
              "    const articulo = pm.response.json().data.articulos.find(item => item.producto_id === 1);",
              "    pm.expect(articulo).to.have.property(\"cantidad\", 4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/carrito"
      }
    },
    {
      "name": "P2 · Consultar carrito sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/carrito"
      }
    },
    {
      "name": "P3 · Intentar consultar solicitudes con token de carrito",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/resumen-solicitud/1"
      }
    }
  ]
}
